# Copy this file to desk.env and fill it in. desk.env is never uploaded (.gitignore).
# One KEY=value per line, no spaces around =, lines starting with # are ignored.
TYPESAFE_API_KEY=apikey_paste-your-jev-key
DESK_SECRET=pick-a-password
DESK_BANK_USD=5000
X_BEARER_TOKEN=paste-your-x-bearer-token
TELEGRAM_TOKEN=123456789:ABC...
TELEGRAM_CHAT=987654321
# TELEGRAM_EVERY_CYCLE=1
# Looser free-cut thresholds for paper testing only (the guide's numbers stay the default):
# DESK_PROFILE=explore
